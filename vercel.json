{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "app/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(auth|reels|styles|chat|pay|upload)(/.*)?", "dest": "/api/$1.js" },
    { "src": "/app/(.*)", "dest": "/app/$1" },
    { "src": "/(.*)", "dest": "/app/index.html" }
  ]
}
